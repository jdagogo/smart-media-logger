{
  "version": "1.0.0",
  "lastUpdated": "2025-12-28",
  "flows": {
    "movie": {
      "name": "Movie",
      "icon": "film",
      "questions": [
        {
          "id": "date",
          "text": "When did you watch this?",
          "type": "date",
          "required": false,
          "voiceEnabled": true,
          "fieldKey": "consumptionDate"
        },
        {
          "id": "location",
          "text": "Where did you watch it?",
          "type": "radio",
          "required": false,
          "voiceEnabled": false,
          "fieldKey": "location",
          "options": [
            { "value": "theater", "label": "Theater" },
            { "value": "home", "label": "Home" },
            { "value": "other", "label": "Other" }
          ],
          "followup": {
            "condition": "selected === 'theater'",
            "question": {
              "id": "theater_name",
              "text": "Which theater? (optional)",
              "type": "text",
              "required": false,
              "voiceEnabled": true,
              "fieldKey": "locationDetail",
              "placeholder": "e.g., Paris Theater, NYC"
            }
          }
        },
        {
          "id": "firstTime",
          "text": "Was this your first time watching it?",
          "type": "radio",
          "required": false,
          "voiceEnabled": false,
          "fieldKey": "firstTime",
          "options": [
            { "value": "true", "label": "Yes, first time" },
            { "value": "false", "label": "No, I've seen it before" }
          ]
        },
        {
          "id": "social",
          "text": "Who were you with?",
          "type": "radio",
          "required": false,
          "voiceEnabled": false,
          "fieldKey": "socialContext",
          "options": [
            { "value": "alone", "label": "Alone" },
            { "value": "friends", "label": "Friends" },
            { "value": "partner", "label": "Partner/Date" },
            { "value": "family", "label": "Family" }
          ],
          "followup": {
            "condition": "selected !== 'alone'",
            "question": {
              "id": "companion_names",
              "text": "Names? (optional)",
              "type": "text",
              "required": false,
              "voiceEnabled": true,
              "fieldKey": "companionNames",
              "placeholder": "e.g., Sarah, Mike"
            }
          }
        },
        {
          "id": "rating",
          "text": "How would you rate it overall?",
          "type": "rating",
          "required": false,
          "voiceEnabled": false,
          "fieldKey": "overallRating"
        },
        {
          "id": "notes",
          "text": "Any other thoughts to remember?",
          "type": "textarea",
          "required": false,
          "voiceEnabled": true,
          "fieldKey": "notes",
          "placeholder": "What stood out? How did it make you feel?"
        }
      ],
      "smartQuestions": {
        "enabled": true,
        "maxQuestions": 3,
        "generatedByAI": true,
        "insertAfter": "rating"
      }
    },

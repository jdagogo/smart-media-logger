# =============================================================
# Smart Media Logger - Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your API keys:
#   cp .env.example .env.local
#
# The app will run without these (hardcoded fallbacks exist for
# TMDB, OMDB, and YouTube), but you should get your own keys
# for production use to avoid rate limits.
# =============================================================

# TMDB (The Movie Database) - Primary metadata source
# Sign up: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here

# OMDB (Open Movie Database) - Scores, plot, ratings
# Sign up: https://www.omdbapi.com/apikey.aspx (free tier: 1000/day)
OMDB_API_KEY=your_api_key_here

# YouTube Data API v3 - Trailers, soundtrack playlists
# Sign up: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=your_api_key_here

# Anthropic Claude API - Entity extraction from user comments
# Sign up: https://console.anthropic.com/
# NOTE: This is the only key with no hardcoded fallback.
# Without it, the entity extraction feature won't work,
# but everything else will.
ANTHROPIC_API_KEY=your_api_key_here
